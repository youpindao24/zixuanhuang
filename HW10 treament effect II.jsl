				Plot Effect Leverage( 0 ), Plot Residual by Normal Quantiles( 0 ),
				Box Cox Y Transformation( 0 )}
			),
			SendToReport(
				Dispatch(
					{"Response Y"},
					"Effect Details",
					OutlineBox,
					{Close( 0 )}
				)
			)
		)
	) << Move Window( 836, 20 ) << Size Window( 473, 813 ) <<
